{
  "manifest_version": 3,
  "name": "StudyLoop Focus Lock",
  "version": "1.0.0",
  "description": "Blocks distracting websites while a StudyLoop session is running.",
  "minimum_chrome_version": "110",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "incognito": "spanning"
}
